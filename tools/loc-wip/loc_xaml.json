 {
  "file": "Views\\SettingsPage.xaml",
  "key": "SettingsPage_23.Text",
  "en": "A Windows service records which apps connect to which hosts and how much data they send and receive, for 30 days. While it runs, the app also shows per-app network speed without administrator rights. The history stays on this PC in C:\\ProgramData\\NaxTaskManager. Every user account on this PC can read it; only administrators can change it. Turning recording off keeps the history already recorded."
 },
 {
  "file": "Views\\SettingsPage.xaml",
  "key": "SettingsPage_24.Text",
  "en": "About"
 },
 {
  "file": "Views\\SettingsPage.xaml",
  "key": "SettingsPage_25.Text",
  "en": "Memory figures come from the same private working-set counters Task Manager uses. Block network adds Windows Filtering Platform filters, which also work while another firewall (for example Bitdefender) manages Windows Firewall."
 },
