<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BetterTaskManager.Fluent.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BetterTaskManager.Fluent.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Margin="4,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Processes" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <CommandBar Grid.Column="2" DefaultLabelPosition="Right" Background="Transparent" IsDynamicOverflowEnabled="True" VerticalAlignment="Center">
                <AppBarButton x:Name="EndTaskButton" Label="End task" IsEnabled="False" Click="EndTask_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="OpenLocationButton" Label="Open file location" IsEnabled="False" Click="OpenLocation_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="FirewallButton" Label="Block network" IsEnabled="False" Click="Firewall_Click">
                    <AppBarButton.Icon>
                        <FontIcon x:Name="FirewallIcon" Glyph="&#xE785;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarToggleButton x:Name="PauseButton" Label="Pause" Click="Pause_Click">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE769;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
            </CommandBar>
        </Grid>

        <!-- Column headers share their widths with every row through ColumnLayout. -->
        <Grid Grid.Row="1" Height="52" Padding="0,0,12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Name, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Cpu, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Memory, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Io, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Bandwidth, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Network, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Publisher, Mode=OneWay}" />
                <ColumnDefinition Width="*" MinWidth="120" />
            </Grid.ColumnDefinitions>

            <Button Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click">
                <Grid>
                    <TextBlock Text="Name" VerticalAlignment="Bottom" Margin="36,0,0,0" />
                    <FontIcon x:Name="SortName" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button Grid.Column="1" Tag="Cpu" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click">
                <Grid>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.CpuHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="CPU" HorizontalAlignment="Right" />
                    </StackPanel>
                    <FontIcon x:Name="SortCpu" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button Grid.Column="2" Tag="Memory" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click">
                <Grid>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.MemoryHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Memory" HorizontalAlignment="Right" />
                    </StackPanel>
                    <FontIcon x:Name="SortMemory" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button Grid.Column="3" Tag="Io" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click" ToolTipService.ToolTip="File and device I/O (read + write + other) per second">
                <Grid>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.IoHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Disk / I/O" HorizontalAlignment="Right" />
                    </StackPanel>
                    <FontIcon x:Name="SortIo" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button Grid.Column="4" Tag="Bandwidth" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click" ToolTipService.ToolTip="{x:Bind ViewModel.BandwidthTooltip, Mode=OneWay}">
                <Grid>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.BandwidthHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Network" HorizontalAlignment="Right" />
                    </StackPanel>
                    <FontIcon x:Name="SortBandwidth" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button Grid.Column="5" Tag="Network" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click" ToolTipService.ToolTip="Open TCP/UDP connections and listeners">
                <Grid>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.NetworkHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Connections" HorizontalAlignment="Right" />
                    </StackPanel>
                    <FontIcon x:Name="SortNetwork" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button Grid.Column="6" Tag="Publisher" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click">
                <Grid>
                    <TextBlock Text="Publisher" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                    <FontIcon x:Name="SortPublisher" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button Grid.Column="7" Tag="Path" Style="{StaticResource ColumnHeaderButtonStyle}" Click="Header_Click">
                <Grid>
                    <TextBlock Text="Path" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                    <FontIcon x:Name="SortPath" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>

            <Thumb Tag="Name" Grid.Column="0" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Cpu" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Memory" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Io" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Bandwidth" Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Network" Grid.Column="5" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Publisher" Grid.Column="6" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
        </Grid>

        <ListView
            x:Name="RowList"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource TableRowStyle}"
            SelectionChanged="RowList_SelectionChanged"
            RightTapped="RowList_RightTapped"
            DoubleTapped="RowList_DoubleTapped">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProcessSlot">
                    <Grid Height="34">
                        <TextBlock
                            Visibility="{x:Bind SectionVisibility, Mode=OneWay}"
                            Text="{x:Bind Name, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Margin="12,0,0,4"
                            VerticalAlignment="Bottom" />
                        <Grid Visibility="{x:Bind RowVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Bind Layout.Name, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Cpu, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Memory, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Io, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Bandwidth, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Network, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Publisher, Mode=OneWay}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="{x:Bind Indent, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Visibility="{x:Bind ChevronVisibility, Mode=OneWay}"
                                    Click="Chevron_Click">
                                    <FontIcon Glyph="&#xE76C;" FontSize="10" RenderTransformOrigin="0.5,0.5">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform Angle="{x:Bind ChevronAngle, Mode=OneWay}" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Button>
                                <Image Grid.Column="1" Width="18" Height="18" Source="{x:Bind Icon, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0">
                                    <Run Text="{x:Bind Name, Mode=OneWay}" />
                                    <Run Text="{x:Bind Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                                <Border
                                    Grid.Column="3"
                                    Margin="0,0,8,0"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    Visibility="{x:Bind BlockedVisibility, Mode=OneWay}"
                                    ToolTipService.ToolTip="Outbound network access is blocked by a Better Task Manager firewall rule">
                                    <TextBlock Text="Blocked" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </Border>
                            </Grid>

                            <Border Grid.Column="1" Background="{x:Bind CpuHeat, Mode=OneWay}">
                                <TextBlock Text="{x:Bind CpuText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </Border>
                            <Border Grid.Column="2" Background="{x:Bind MemoryHeat, Mode=OneWay}">
                                <TextBlock Text="{x:Bind MemoryText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </Border>
                            <Border Grid.Column="3" Background="{x:Bind IoHeat, Mode=OneWay}">
                                <TextBlock Text="{x:Bind IoText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </Border>
                            <Border Grid.Column="4" Background="{x:Bind BandwidthHeat, Mode=OneWay}">
                                <TextBlock Text="{x:Bind BandwidthText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </Border>
                            <Border Grid.Column="5" Background="{x:Bind NetworkHeat, Mode=OneWay}">
                                <TextBlock Text="{x:Bind NetworkText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </Border>
                            <TextBlock
                                Grid.Column="6"
                                Margin="10,0,8,0"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Publisher, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="7"
                                Margin="10,0,8,0"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Path, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
