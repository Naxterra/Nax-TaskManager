<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BetterTaskManager.Fluent.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BetterTaskManager.Fluent.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Margin="4,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Uid="ProcessesPage_1" Text="Processes" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <SelectorBar x:Name="ModeSelector" Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0" SelectionChanged="ModeSelector_SelectionChanged">
                <SelectorBarItem x:Uid="ProcessesPage_29" x:Name="ByAppMode" Text="By app" IsSelected="True" />
                <SelectorBarItem x:Uid="ProcessesPage_30" x:Name="FlatMode" Text="All processes" />
            </SelectorBar>
            <CommandBar Grid.Column="2" DefaultLabelPosition="Right" Background="Transparent" IsDynamicOverflowEnabled="True" VerticalAlignment="Center">
                <AppBarButton x:Uid="ProcessesPage_2" x:Name="EndTaskButton" Label="End task" IsEnabled="False" Click="EndTask_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Uid="ProcessesPage_3" x:Name="OpenLocationButton" Label="Open file location" IsEnabled="False" Click="OpenLocation_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="ProcessesPage_4" x:Name="FirewallButton" Label="Block network" IsEnabled="False" Click="Firewall_Click">
                    <AppBarButton.Icon>
                        <FontIcon x:Name="FirewallIcon" Glyph="&#xE785;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarToggleButton x:Uid="ProcessesPage_5" x:Name="PauseButton" Label="Pause" Click="Pause_Click">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE769;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Uid="ProcessesPage_6" x:Name="EndTreeButton" Label="End process tree" IsEnabled="False" Click="EndTree_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE71A;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarToggleButton x:Uid="ProcessesPage_28" x:Name="EfficiencyButton" Label="Efficiency mode" IsEnabled="False" Click="Efficiency_Click">
                        <AppBarToggleButton.Icon>
                            <PathIcon Data="M15,1 C7,1 2,5 2,11 C2,12.2 2.3,13.2 2.9,14 L1,15.9 L2.1,17 L4,15.1 C4.9,15.7 5.9,16 7,16 C13,16 15,10 15,1 Z" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarButton x:Uid="ProcessesPage_7" x:Name="PropertiesButton" Label="Properties" IsEnabled="False" Click="Properties_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Uid="ProcessesPage_8" x:Name="CopyPathButton" Label="Copy path" IsEnabled="False" Click="CopyPath_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- ===== Grouped ("By app") layout ===== -->
        <Grid x:Name="GroupedHeader" Grid.Row="1" Height="52" Padding="0,0,12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Name, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Cpu, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Memory, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Io, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Bandwidth, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Network, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Publisher, Mode=OneWay}" />
                <ColumnDefinition Width="*" MinWidth="120" />
            </Grid.ColumnDefinitions>

            <Button x:Uid="ProcessesPage_9" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Name" Click="Header_Click">
                <Grid>
                    <TextBlock x:Uid="ProcessesPage_10" Text="Name" VerticalAlignment="Bottom" Margin="36,0,0,0" />
                    <FontIcon x:Name="SortName" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="ProcessesPage_11" Grid.Column="1" Tag="Cpu" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by CPU" Click="Header_Click">
                <Grid>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.CpuHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="CPU" HorizontalAlignment="Right" />
                    </StackPanel>
                    <FontIcon x:Name="SortCpu" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="ProcessesPage_12" Grid.Column="2" Tag="Memory" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Memory" Click="Header_Click">
                <Grid>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.MemoryHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="ProcessesPage_13" Text="Memory" HorizontalAlignment="Right" />
                    </StackPanel>
                    <FontIcon x:Name="SortMemory" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="ProcessesPage_14" Grid.Column="3" Tag="Io" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Disk / I/O" Click="Header_Click" ToolTipService.ToolTip="File and device I/O (read + write + other) per second">
                <Grid>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.IoHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="ProcessesPage_15" Text="Disk / I/O" HorizontalAlignment="Right" />
                    </StackPanel>
                    <FontIcon x:Name="SortIo" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="ProcessesPage_16" Grid.Column="4" Tag="Bandwidth" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Network speed" Click="Header_Click" ToolTipService.ToolTip="{x:Bind ViewModel.BandwidthTooltip, Mode=OneWay}">
                <Grid>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.BandwidthHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="ProcessesPage_17" Text="Network" HorizontalAlignment="Right" />
                    </StackPanel>
                    <FontIcon x:Name="SortBandwidth" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="ProcessesPage_18" Grid.Column="5" Tag="Network" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Connections" Click="Header_Click" ToolTipService.ToolTip="Open TCP/UDP connections and listeners">
                <Grid>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind ViewModel.NetworkHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="ProcessesPage_19" Text="Connections" HorizontalAlignment="Right" />
                    </StackPanel>
                    <FontIcon x:Name="SortNetwork" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="ProcessesPage_20" Grid.Column="6" Tag="Publisher" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Publisher" Click="Header_Click">
                <Grid>
                    <TextBlock x:Uid="ProcessesPage_21" Text="Publisher" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                    <FontIcon x:Name="SortPublisher" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="ProcessesPage_22" Grid.Column="7" Tag="Path" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Path" Click="Header_Click">
                <Grid>
                    <TextBlock x:Uid="ProcessesPage_23" Text="Path" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                    <FontIcon x:Name="SortPath" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </Button>

            <Thumb Tag="Name" Grid.Column="0" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
            <Thumb Tag="Cpu" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
            <Thumb Tag="Memory" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
            <Thumb Tag="Io" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
            <Thumb Tag="Bandwidth" Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
            <Thumb Tag="Network" Grid.Column="5" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
            <Thumb Tag="Publisher" Grid.Column="6" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
        </Grid>

        <ListView
            x:Name="RowList"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource TableRowStyle}"
            SelectionChanged="RowList_SelectionChanged"
            ContextRequested="RowList_ContextRequested"
            DoubleTapped="RowList_DoubleTapped">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProcessSlot">
                    <Grid Height="34">
                        <TextBlock
                            Visibility="{x:Bind SectionVisibility, Mode=OneWay}"
                            Text="{x:Bind Name, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Margin="12,0,0,4"
                            VerticalAlignment="Bottom" />
                        <Grid Visibility="{x:Bind RowVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Bind Layout.Name, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Cpu, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Memory, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Io, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Bandwidth, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Network, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Layout.Publisher, Mode=OneWay}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="{x:Bind Indent, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Visibility="{x:Bind ChevronVisibility, Mode=OneWay}"
                                    Click="Chevron_Click">
                                    <FontIcon Glyph="&#xE76C;" FontSize="10" RenderTransformOrigin="0.5,0.5">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform Angle="{x:Bind ChevronAngle, Mode=OneWay}" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Button>
                                <Image Grid.Column="1" Width="18" Height="18" Source="{x:Bind Icon, Mode=OneWay}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0">
                                    <Run Text="{x:Bind Name, Mode=OneWay}" />
                                    <Run Text="{x:Bind Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path x:Uid="ProcessesPage_26"
                                        Width="14"
                                        Height="14"
                                        Stretch="Uniform"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                        Data="M15,1 C7,1 2,5 2,11 C2,12.2 2.3,13.2 2.9,14 L1,15.9 L2.1,17 L4,15.1 C4.9,15.7 5.9,16 7,16 C13,16 15,10 15,1 Z"
                                        Visibility="{x:Bind EfficiencyVisibility, Mode=OneWay}"
                                        ToolTipService.ToolTip="Efficiency mode" />
                                    <FontIcon x:Uid="ProcessesPage_27"
                                        Glyph="&#xE769;"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{x:Bind SuspendedVisibility, Mode=OneWay}"
                                        ToolTipService.ToolTip="Suspended" />
                                    <Border x:Uid="ProcessesPage_24"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        CornerRadius="4"
                                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                        Visibility="{x:Bind BlockedVisibility, Mode=OneWay}"
                                        ToolTipService.ToolTip="Outbound network access is blocked by Nax-TaskManager">
                                        <TextBlock x:Uid="ProcessesPage_25" Text="Blocked" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="1" Background="{x:Bind CpuHeat, Mode=OneWay}">
                                <TextBlock Text="{x:Bind CpuText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </Border>
                            <Border Grid.Column="2" Background="{x:Bind MemoryHeat, Mode=OneWay}">
                                <TextBlock Text="{x:Bind MemoryText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </Border>
                            <Border Grid.Column="3" Background="{x:Bind IoHeat, Mode=OneWay}">
                                <TextBlock Text="{x:Bind IoText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </Border>
                            <Border Grid.Column="4" Background="{x:Bind BandwidthHeat, Mode=OneWay}">
                                <TextBlock Text="{x:Bind BandwidthText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </Border>
                            <Border Grid.Column="5" Background="{x:Bind NetworkHeat, Mode=OneWay}">
                                <TextBlock Text="{x:Bind NetworkText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </Border>
                            <TextBlock
                                Grid.Column="6"
                                Margin="10,0,8,0"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Publisher, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="7"
                                Margin="10,0,8,0"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Path, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ===== Flat ("All processes") layout ===== -->
        <Grid x:Name="FlatHeader" Grid.Row="1" Height="40" Padding="0,0,12,0" Visibility="Collapsed" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.Name, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.Pid, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.Status, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.User, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.Cpu, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.Memory, Mode=OneWay}" />
                <ColumnDefinition Width="*" MinWidth="120" />
            </Grid.ColumnDefinitions>
            <Button x:Uid="DetailsPage_10" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Name" Click="FlatHeader_Click">
                <Grid>
                    <TextBlock x:Uid="DetailsPage_11" Text="Name" Margin="28,0,0,0" />
                    <FontIcon x:Name="FlatSortName" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="DetailsPage_12" Grid.Column="1" Tag="Pid" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by PID" Click="FlatHeader_Click">
                <Grid>
                    <TextBlock Text="PID" HorizontalAlignment="Right" />
                    <FontIcon x:Name="FlatSortPid" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="DetailsPage_13" Grid.Column="2" Tag="Status" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Status" Click="FlatHeader_Click">
                <Grid>
                    <TextBlock x:Uid="DetailsPage_14" Text="Status" />
                    <FontIcon x:Name="FlatSortStatus" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="DetailsPage_15" Grid.Column="3" Tag="User" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by User name" Click="FlatHeader_Click">
                <Grid>
                    <TextBlock x:Uid="DetailsPage_16" Text="User name" />
                    <FontIcon x:Name="FlatSortUser" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="DetailsPage_17" Grid.Column="4" Tag="Cpu" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by CPU" Click="FlatHeader_Click">
                <Grid>
                    <TextBlock Text="CPU" HorizontalAlignment="Right" />
                    <FontIcon x:Name="FlatSortCpu" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="DetailsPage_18" Grid.Column="5" Tag="Memory" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Memory" Click="FlatHeader_Click">
                <Grid>
                    <TextBlock x:Uid="DetailsPage_19" Text="Memory" HorizontalAlignment="Right" />
                    <FontIcon x:Name="FlatSortMemory" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="DetailsPage_22" Grid.Column="6" Tag="Description" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Description" Click="FlatHeader_Click">
                <Grid>
                    <TextBlock x:Uid="DetailsPage_23" Text="Description" />
                    <FontIcon x:Name="FlatSortDescription" FontSize="10" Glyph="&#xE70D;" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Button>

            <Thumb Tag="Name" Grid.Column="0" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
            <Thumb Tag="Pid" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
            <Thumb Tag="Status" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
            <Thumb Tag="User" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
            <Thumb Tag="Cpu" Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
            <Thumb Tag="Memory" Grid.Column="5" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
        </Grid>

        <ListView
            x:Name="FlatList"
            Grid.Row="2"
            Visibility="Collapsed"
            ItemsSource="{x:Bind FlatViewModel.Rows}"
            SelectionMode="Single"
            ItemContainerStyle="{StaticResource TableRowStyle}"
            SelectionChanged="FlatList_SelectionChanged"
            ContextRequested="FlatList_ContextRequested">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DetailSlot">
                    <Grid Height="34" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Layout.Name, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Pid, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Status, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.User, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Cpu, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Memory, Mode=OneWay}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,8,0">
                            <Image Width="16" Height="16" Source="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind PidText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{x:Bind User, Mode=OneWay}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="4" Background="{x:Bind CpuHeat, Mode=OneWay}">
                            <TextBlock Text="{x:Bind CpuText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                        </Border>
                        <Border Grid.Column="5" Background="{x:Bind MemoryHeat, Mode=OneWay}">
                            <TextBlock Text="{x:Bind MemoryText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                        </Border>
                        <TextBlock Grid.Column="6" Text="{x:Bind Description, Mode=OneWay}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
