<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BetterTaskManager.Fluent.Views.ProcessesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:BetterTaskManager.Fluent.ViewModels" xmlns:controls="using:BetterTaskManager.Fluent.Controls" NavigationCacheMode="Required">

    <Grid Padding="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Page header: title and summary, then the actions with "End task" as the accent button. -->
        <Grid Margin="0,0,0,20" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Uid="ProcessesPage_1" Text="Processes" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Uid="ProcessesPage_33" x:Name="EndTaskButton" AutomationProperties.Name="End task" IsEnabled="False" Click="EndTask_Click" MinWidth="120">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="" FontSize="14" />
                        <TextBlock x:Uid="ProcessesPage_32" Text="End task" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </Button.KeyboardAccelerators>
                </Button>
                <CommandBar x:Name="PageCommands" DefaultLabelPosition="Right" Background="Transparent" IsDynamicOverflowEnabled="True" VerticalAlignment="Center">
                    <AppBarButton x:Uid="ProcessesPage_3" x:Name="OpenLocationButton" Label="Open file location" IsEnabled="False" Click="OpenLocation_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Uid="ProcessesPage_4" x:Name="FirewallButton" Label="Block network" IsEnabled="False" Click="Firewall_Click">
                        <AppBarButton.Icon>
                            <FontIcon x:Name="FirewallIcon" Glyph="" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarToggleButton x:Uid="ProcessesPage_5" x:Name="PauseButton" Label="Pause" Click="Pause_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarToggleButton x:Uid="ProcessesPage_34" x:Name="DetailsToggle" Label="Details" Click="DetailsToggle_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton x:Uid="ProcessesPage_6" x:Name="EndTreeButton" Label="End process tree" IsEnabled="False" Click="EndTree_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarToggleButton x:Uid="ProcessesPage_28" x:Name="EfficiencyButton" Label="Efficiency mode" IsEnabled="False" Click="Efficiency_Click">
                            <AppBarToggleButton.Icon>
                                <PathIcon Data="M15,1 C7,1 2,5 2,11 C2,12.2 2.3,13.2 2.9,14 L1,15.9 L2.1,17 L4,15.1 C4.9,15.7 5.9,16 7,16 C13,16 15,10 15,1 Z" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarButton x:Uid="ProcessesPage_7" x:Name="PropertiesButton" Label="Properties" IsEnabled="False" Click="Properties_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Uid="ProcessesPage_8" x:Name="CopyPathButton" Label="Copy path" IsEnabled="False" Click="CopyPath_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </StackPanel>
        </Grid>

        <!-- Tiles: the machine at a glance, with the last minute as a sparkline. -->
        <Grid x:Name="Tiles" Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="GpuTileColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <controls:StatTile x:Name="CpuTile" Stroke="{ThemeResource ChartCpuBrush}" />
            <controls:StatTile x:Name="MemoryTile" Grid.Column="1" Stroke="{ThemeResource ChartMemoryBrush}" />
            <controls:StatTile x:Name="DiskTile" Grid.Column="2" Stroke="{ThemeResource ChartDiskBrush}" SecondStroke="{ThemeResource ChartSendBrush}" />
            <controls:StatTile x:Name="NetworkTile" Grid.Column="3" Stroke="{ThemeResource ChartReceiveBrush}" SecondStroke="{ThemeResource ChartSendBrush}" />
            <controls:StatTile x:Name="GpuTile" Grid.Column="4" Stroke="{ThemeResource ChartGpuBrush}" />
        </Grid>

        <controls:DetailPane x:Name="Details" Grid.Row="2" Grid.Column="1" Width="296" Margin="16,0,0,0" />

        <Border Grid.Row="2" Style="{StaticResource TableCardStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled"><Grid MinWidth="{x:Bind ViewModel.Layout.TableWidth, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The view switch lives in the card, like tabs over the table. -->
                <Grid Padding="10,6,10,4" Background="{ThemeResource SurfaceRaisedBrush}" CornerRadius="10,10,0,0">
                    <SelectorBar x:Name="ModeSelector" VerticalAlignment="Center" SelectionChanged="ModeSelector_SelectionChanged">
                        <SelectorBarItem x:Uid="ProcessesPage_29" x:Name="ByAppMode" Text="By app" IsSelected="True" />
                        <SelectorBarItem x:Uid="ProcessesPage_30" x:Name="FlatMode" Text="All processes" />
                    </SelectorBar>
                </Grid>

                <!-- ===== Grouped ("By app") layout ===== -->
                <Grid x:Name="GroupedHeader" Grid.Row="1" Height="52" Style="{StaticResource TableHeaderStyle}" CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.Name, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W1, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W2, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W3, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W4, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W5, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W6, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W7, Mode=OneWay}" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <Button x:Uid="ProcessesPage_9" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Name" Click="Header_Click">
                        <Grid>
                            <TextBlock x:Uid="ProcessesPage_10" Text="Name" VerticalAlignment="Bottom" Margin="36,0,0,0" />
                            <FontIcon x:Name="SortName" FontSize="10" Glyph="" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="ProcessesPage_11" Grid.Column="{x:Bind ViewModel.Layout.CpuColumn, Mode=OneWay}" Tag="Cpu" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by CPU" Click="Header_Click">
                        <Grid>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind ViewModel.CpuHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="CPU" HorizontalAlignment="Right" />
                            </StackPanel>
                            <FontIcon x:Name="SortCpu" FontSize="10" Glyph="" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="ProcessesPage_12" Grid.Column="{x:Bind ViewModel.Layout.MemoryColumn, Mode=OneWay}" Tag="Memory" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Memory" Click="Header_Click">
                        <Grid>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind ViewModel.MemoryHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Uid="ProcessesPage_13" Text="Memory" HorizontalAlignment="Right" />
                            </StackPanel>
                            <FontIcon x:Name="SortMemory" FontSize="10" Glyph="" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="ProcessesPage_14" Grid.Column="{x:Bind ViewModel.Layout.IoColumn, Mode=OneWay}" Tag="Io" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Disk" Click="Header_Click" ToolTipService.ToolTip="{x:Bind ViewModel.IoTooltip, Mode=OneWay}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind ViewModel.IoHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.IoLabel, Mode=OneWay}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <FontIcon x:Name="SortIo" FontSize="10" Glyph="" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="ProcessesPage_16" Grid.Column="{x:Bind ViewModel.Layout.BandwidthColumn, Mode=OneWay}" Tag="Bandwidth" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Network speed" Click="Header_Click" ToolTipService.ToolTip="{x:Bind ViewModel.BandwidthTooltip, Mode=OneWay}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind ViewModel.BandwidthHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Uid="ProcessesPage_17" Text="Network" HorizontalAlignment="Right" />
                            </StackPanel>
                            <FontIcon x:Name="SortBandwidth" FontSize="10" Glyph="" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="ProcessesPage_18" Grid.Column="{x:Bind ViewModel.Layout.NetworkColumn, Mode=OneWay}" Tag="Network" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Connections" Click="Header_Click" ToolTipService.ToolTip="Open TCP/UDP connections and listeners">
                        <Grid>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind ViewModel.NetworkHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Uid="ProcessesPage_19" Text="Connections" HorizontalAlignment="Right" />
                            </StackPanel>
                            <FontIcon x:Name="SortNetwork" FontSize="10" Glyph="" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="ProcessesPage_31" Grid.Column="{x:Bind ViewModel.Layout.GpuColumn, Mode=OneWay}" Tag="Gpu" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by GPU" Click="Header_Click" ToolTipService.ToolTip="Busiest GPU engine of each process, as in Task Manager">
                        <Grid>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind ViewModel.GpuHeader, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="GPU" HorizontalAlignment="Right" />
                            </StackPanel>
                            <FontIcon x:Name="SortGpu" FontSize="10" Glyph="" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="ProcessesPage_20" Grid.Column="{x:Bind ViewModel.Layout.PublisherColumn, Mode=OneWay}" Tag="Publisher" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Publisher" Click="Header_Click">
                        <Grid>
                            <TextBlock x:Uid="ProcessesPage_21" Text="Publisher" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                            <FontIcon x:Name="SortPublisher" FontSize="10" Glyph="" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="ProcessesPage_22" Grid.Column="8" Tag="Path" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Path" Click="Header_Click">
                        <Grid>
                            <TextBlock x:Uid="ProcessesPage_23" Text="Path" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                            <FontIcon x:Name="SortPath" FontSize="10" Glyph="" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Thumb Tag="Name" Grid.Column="0" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
                    <Thumb Tag="Cpu" Grid.Column="{x:Bind ViewModel.Layout.CpuColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
                    <Thumb Tag="Memory" Grid.Column="{x:Bind ViewModel.Layout.MemoryColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
                    <Thumb Tag="Io" Grid.Column="{x:Bind ViewModel.Layout.IoColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
                    <Thumb Tag="Bandwidth" Grid.Column="{x:Bind ViewModel.Layout.BandwidthColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
                    <Thumb Tag="Network" Grid.Column="{x:Bind ViewModel.Layout.NetworkColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
                    <Thumb Tag="Gpu" Grid.Column="{x:Bind ViewModel.Layout.GpuColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
                    <Thumb Tag="Publisher" Grid.Column="{x:Bind ViewModel.Layout.PublisherColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="GroupedSplitter_DragDelta" />
                </Grid>

                <ListView x:Name="RowList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Single" IsItemClickEnabled="False" ItemContainerStyle="{StaticResource TableRowStyle}" SelectionChanged="RowList_SelectionChanged" ContextRequested="RowList_ContextRequested" DoubleTapped="RowList_DoubleTapped">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProcessSlot">
                            <Grid Height="40" PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                <TextBlock Visibility="{x:Bind SectionVisibility, Mode=OneWay}" Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="12,0,0,4" VerticalAlignment="Bottom" />
                                <Grid Visibility="{x:Bind RowVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind Layout.Name, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Layout.W1, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Layout.W2, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Layout.W3, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Layout.W4, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Layout.W5, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Layout.W6, Mode=OneWay}" />
                                        <ColumnDefinition Width="{x:Bind Layout.W7, Mode=OneWay}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Margin="{x:Bind Indent, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Visibility="{x:Bind ChevronVisibility, Mode=OneWay}" Click="Chevron_Click">
                                            <FontIcon Glyph="" FontSize="10" RenderTransformOrigin="0.5,0.5">
                                                <FontIcon.RenderTransform>
                                                    <RotateTransform Angle="{x:Bind ChevronAngle, Mode=OneWay}" />
                                                </FontIcon.RenderTransform>
                                            </FontIcon>
                                        </Button>
                                        <Image Grid.Column="1" Width="20" Height="20" Source="{x:Bind Icon, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,8,0">
                                            <Run Text="{x:Bind Name, Mode=OneWay}" />
                                            <Run Text="{x:Bind Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path x:Uid="ProcessesPage_26" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" Data="M15,1 C7,1 2,5 2,11 C2,12.2 2.3,13.2 2.9,14 L1,15.9 L2.1,17 L4,15.1 C4.9,15.7 5.9,16 7,16 C13,16 15,10 15,1 Z" Visibility="{x:Bind EfficiencyVisibility, Mode=OneWay}" ToolTipService.ToolTip="Efficiency mode" />
                                            <FontIcon x:Uid="ProcessesPage_27" Glyph="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind SuspendedVisibility, Mode=OneWay}" ToolTipService.ToolTip="Suspended" />
                                            <Border x:Uid="ProcessesPage_24" Padding="6,1" VerticalAlignment="Center" CornerRadius="4" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind BlockedVisibility, Mode=OneWay}" ToolTipService.ToolTip="Outbound network access is blocked by Nax-TaskManager">
                                                <TextBlock x:Uid="ProcessesPage_25" Text="Blocked" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Column="{x:Bind Layout.CpuColumn, Mode=OneWay}" Margin="6,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind Cpu.Bar, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind Cpu.Rest, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Style="{StaticResource MeterBarStyle}" Fill="{ThemeResource MeterCpuBrush}" />
                                        <TextBlock Grid.ColumnSpan="2" Text="{x:Bind CpuText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="{x:Bind Layout.MemoryColumn, Mode=OneWay}" Margin="6,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind Memory.Bar, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind Memory.Rest, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Style="{StaticResource MeterBarStyle}" Fill="{ThemeResource MeterMemoryBrush}" />
                                        <TextBlock Grid.ColumnSpan="2" Text="{x:Bind MemoryText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="{x:Bind Layout.IoColumn, Mode=OneWay}" Margin="6,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind Io.Bar, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind Io.Rest, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Style="{StaticResource MeterBarStyle}" Fill="{ThemeResource MeterDiskBrush}" />
                                        <TextBlock Grid.ColumnSpan="2" Text="{x:Bind IoText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="{x:Bind Layout.BandwidthColumn, Mode=OneWay}" Margin="6,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind Bandwidth.Bar, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind Bandwidth.Rest, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Style="{StaticResource MeterBarStyle}" Fill="{ThemeResource MeterNetworkBrush}" />
                                        <TextBlock Grid.ColumnSpan="2" Text="{x:Bind BandwidthText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="{x:Bind Layout.NetworkColumn, Mode=OneWay}" Margin="6,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind Network.Bar, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind Network.Rest, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Style="{StaticResource MeterBarStyle}" Fill="{ThemeResource MeterConnectionsBrush}" />
                                        <TextBlock Grid.ColumnSpan="2" Text="{x:Bind NetworkText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="{x:Bind Layout.GpuColumn, Mode=OneWay}" Margin="6,0,10,0" ToolTipService.ToolTip="{x:Bind GpuEngine, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind Gpu.Bar, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind Gpu.Rest, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Style="{StaticResource MeterBarStyle}" Fill="{ThemeResource MeterGpuBrush}" />
                                        <TextBlock Grid.ColumnSpan="2" Text="{x:Bind GpuText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="{x:Bind Layout.PublisherColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Publisher, Mode=OneWay}" />
                                    <TextBlock Grid.Column="8" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Path, Mode=OneWay}" />
                                    <Button x:Uid="Common_RowMenu" Grid.Column="9" Style="{StaticResource RowMenuButtonStyle}" Visibility="{x:Bind MenuVisibility, Mode=OneWay}" Click="RowMenu_Click" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- ===== Flat ("All processes") layout ===== -->
                <Grid x:Name="FlatHeader" Grid.Row="1" Height="40" Visibility="Collapsed" Style="{StaticResource TableHeaderStyle}" CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.Name, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.W1, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.W2, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.W3, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.W4, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.W5, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind FlatViewModel.Layout.W6, Mode=OneWay}" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="DetailsPage_10" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Name" Click="FlatHeader_Click">
                        <Grid>
                            <TextBlock x:Uid="DetailsPage_11" Text="Name" Margin="28,0,0,0" />
                            <FontIcon x:Name="FlatSortName" FontSize="10" Glyph="" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="DetailsPage_12" Grid.Column="{x:Bind FlatViewModel.Layout.PidColumn, Mode=OneWay}" Tag="Pid" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by PID" Click="FlatHeader_Click">
                        <Grid>
                            <TextBlock Text="PID" HorizontalAlignment="Right" />
                            <FontIcon x:Name="FlatSortPid" FontSize="10" Glyph="" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="DetailsPage_13" Grid.Column="{x:Bind FlatViewModel.Layout.StatusColumn, Mode=OneWay}" Tag="Status" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Status" Click="FlatHeader_Click">
                        <Grid>
                            <TextBlock x:Uid="DetailsPage_14" Text="Status" />
                            <FontIcon x:Name="FlatSortStatus" FontSize="10" Glyph="" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="DetailsPage_15" Grid.Column="{x:Bind FlatViewModel.Layout.UserColumn, Mode=OneWay}" Tag="User" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by User name" Click="FlatHeader_Click">
                        <Grid>
                            <TextBlock x:Uid="DetailsPage_16" Text="User name" />
                            <FontIcon x:Name="FlatSortUser" FontSize="10" Glyph="" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="DetailsPage_17" Grid.Column="{x:Bind FlatViewModel.Layout.CpuColumn, Mode=OneWay}" Tag="Cpu" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by CPU" Click="FlatHeader_Click">
                        <Grid>
                            <TextBlock Text="CPU" HorizontalAlignment="Right" />
                            <FontIcon x:Name="FlatSortCpu" FontSize="10" Glyph="" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="DetailsPage_18" Grid.Column="{x:Bind FlatViewModel.Layout.MemoryColumn, Mode=OneWay}" Tag="Memory" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Memory" Click="FlatHeader_Click">
                        <Grid>
                            <TextBlock x:Uid="DetailsPage_19" Text="Memory" HorizontalAlignment="Right" />
                            <FontIcon x:Name="FlatSortMemory" FontSize="10" Glyph="" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="DetailsPage_24" Grid.Column="{x:Bind FlatViewModel.Layout.GpuColumn, Mode=OneWay}" Tag="Gpu" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by GPU" Click="FlatHeader_Click">
                        <Grid>
                            <TextBlock Text="GPU" HorizontalAlignment="Right" />
                            <FontIcon x:Name="FlatSortGpu" FontSize="10" Glyph="" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Uid="DetailsPage_22" Grid.Column="7" Tag="Description" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Description" Click="FlatHeader_Click">
                        <Grid>
                            <TextBlock x:Uid="DetailsPage_23" Text="Description" />
                            <FontIcon x:Name="FlatSortDescription" FontSize="10" Glyph="" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Button>

                    <Thumb Tag="Name" Grid.Column="0" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
                    <Thumb Tag="Pid" Grid.Column="{x:Bind FlatViewModel.Layout.PidColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
                    <Thumb Tag="Status" Grid.Column="{x:Bind FlatViewModel.Layout.StatusColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
                    <Thumb Tag="User" Grid.Column="{x:Bind FlatViewModel.Layout.UserColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
                    <Thumb Tag="Cpu" Grid.Column="{x:Bind FlatViewModel.Layout.CpuColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
                    <Thumb Tag="Memory" Grid.Column="{x:Bind FlatViewModel.Layout.MemoryColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
                    <Thumb Tag="Gpu" Grid.Column="{x:Bind FlatViewModel.Layout.GpuColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="FlatSplitter_DragDelta" />
                </Grid>

                <ListView x:Name="FlatList" Grid.Row="2" Visibility="Collapsed" ItemsSource="{x:Bind FlatViewModel.Rows}" SelectionMode="Single" ItemContainerStyle="{StaticResource TableRowStyle}" SelectionChanged="FlatList_SelectionChanged" ContextRequested="FlatList_ContextRequested">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetailSlot">
                            <Grid Height="40" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}" PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind Layout.Name, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W1, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W2, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W3, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W4, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W5, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W6, Mode=OneWay}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,8,0">
                                    <Image Width="18" Height="18" Source="{x:Bind Icon, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="{x:Bind Layout.PidColumn, Mode=OneWay}" Text="{x:Bind PidText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="{x:Bind Layout.StatusColumn, Mode=OneWay}" Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="{x:Bind Layout.UserColumn, Mode=OneWay}" Text="{x:Bind User, Mode=OneWay}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Column="{x:Bind Layout.CpuColumn, Mode=OneWay}" Margin="6,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind Cpu.Bar, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind Cpu.Rest, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Style="{StaticResource MeterBarStyle}" Fill="{ThemeResource MeterCpuBrush}" />
                                        <TextBlock Grid.ColumnSpan="2" Text="{x:Bind CpuText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                <Grid Grid.Column="{x:Bind Layout.MemoryColumn, Mode=OneWay}" Margin="6,0,10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind Memory.Bar, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind Memory.Rest, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Style="{StaticResource MeterBarStyle}" Fill="{ThemeResource MeterMemoryBrush}" />
                                        <TextBlock Grid.ColumnSpan="2" Text="{x:Bind MemoryText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                <Grid Grid.Column="{x:Bind Layout.GpuColumn, Mode=OneWay}" Margin="6,0,10,0" ToolTipService.ToolTip="{x:Bind GpuEngine, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind Gpu.Bar, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind Gpu.Rest, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Style="{StaticResource MeterBarStyle}" Fill="{ThemeResource MeterGpuBrush}" />
                                        <TextBlock Grid.ColumnSpan="2" Text="{x:Bind GpuText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                <TextBlock Grid.Column="7" Text="{x:Bind Description, Mode=OneWay}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Uid="Common_RowMenu" Grid.Column="8" Style="{StaticResource RowMenuButtonStyle}" Visibility="{x:Bind MenuVisibility, Mode=OneWay}" Click="RowMenu_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid></ScrollViewer>
        </Border>
    </Grid>
</Page>
