<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BetterTaskManager.Fluent.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BetterTaskManager.Fluent.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Uid="HistoryPage_1" Text="History" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Uid="HistoryPage_2" x:Name="DnsToggle" Click="DnsToggle_Click" ToolTipService.ToolTip="Show which names each app looked up (recorded by the History service)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                        <TextBlock x:Uid="HistoryPage_3" Text="DNS lookups" />
                    </StackPanel>
                </ToggleButton>
                <ComboBox x:Name="RangeBox" MinWidth="150" SelectedIndex="0" SelectionChanged="RangeBox_SelectionChanged">
                    <ComboBoxItem x:Uid="HistoryPage_4" Content="Today" />
                    <ComboBoxItem x:Uid="HistoryPage_5" Content="Last 7 days" />
                    <ComboBoxItem x:Uid="HistoryPage_6" Content="Last 30 days" />
                </ComboBox>
                <Button x:Uid="HistoryPage_7" x:Name="RefreshButton" ToolTipService.ToolTip="Refresh" Click="Refresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ServiceBar"
            Grid.Row="1"
            Margin="0,0,0,8"
            IsClosable="False"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button x:Name="ServiceButton" Click="ServiceButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Apps by data used -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="0,0,12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <TextBlock x:Uid="HistoryPage_8" Text="App" Margin="44,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="HistoryPage_9" Text="Data used" Margin="0,0,0,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView
                    x:Name="AppList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Apps}"
                    SelectionMode="Single"
                    SelectionChanged="AppList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource TableRowStyle}">
                            <Setter Property="MinHeight" Value="60" />
                            <Setter Property="Height" Value="60" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppUsageSlot">
                            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Width="20" Height="20" Margin="6,0,0,0" Source="{x:Bind Icon, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <Rectangle Width="{x:Bind BarWidth, Mode=OneWay}" Height="4" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                                               Fill="{ThemeResource ChartReceiveBrush}" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Total, Mode=OneWay}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind Split, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Connection log -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="0,0,12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="HistoryPage_10" Text="Started" Margin="10,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="HistoryPage_11" Grid.Column="1" Text="App" Margin="36,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="HistoryPage_12" Grid.Column="2" Text="Remote host" Margin="10,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="HistoryPage_13" Grid.Column="3" Text="Protocol" Margin="10,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="HistoryPage_14" Grid.Column="4" Text="Data" Margin="10,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView
                    x:Name="ConnectionList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Connections}"
                    SelectionMode="Single"
                    ItemContainerStyle="{StaticResource TableRowStyle}"
                    ContextRequested="ConnectionList_ContextRequested">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionLogSlot">
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" MinWidth="160" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="10,0,8,0" VerticalAlignment="Center" Text="{x:Bind Time, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind TimeDetail, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,8,0" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                                    <Image Width="18" Height="18" Source="{x:Bind Icon, Mode=OneWay}" />
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" Text="{x:Bind App, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Remote, Mode=OneWay}"
                                           ToolTipService.ToolTip="{x:Bind RemoteDetail, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Protocol, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Margin="10,0,8,0" VerticalAlignment="Center" Text="{x:Bind Data, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="10,16,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="ConnectionSummaryText" Grid.Row="2" Margin="10,6,0,8" Style="{StaticResource MutedTextStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
