<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BetterTaskManager.Fluent.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BetterTaskManager.Fluent.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Uid="HistoryPage_1" Text="History" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Uid="HistoryPage_2" x:Name="DnsToggle" Click="DnsToggle_Click" ToolTipService.ToolTip="Show which names each app looked up (recorded by the History service)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                        <TextBlock x:Uid="HistoryPage_3" Text="DNS lookups" />
                    </StackPanel>
                </ToggleButton>
                <ComboBox x:Name="RangeBox" MinWidth="150" SelectedIndex="0" SelectionChanged="RangeBox_SelectionChanged">
                    <ComboBoxItem x:Uid="HistoryPage_4" Content="Today" />
                    <ComboBoxItem x:Uid="HistoryPage_5" Content="Last 7 days" />
                    <ComboBoxItem x:Uid="HistoryPage_6" Content="Last 30 days" />
                </ComboBox>
                <Button x:Uid="HistoryPage_7" x:Name="RefreshButton" ToolTipService.ToolTip="Refresh" Click="Refresh_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ServiceBar"
            Grid.Row="1"
            Margin="0,0,0,8"
            IsClosable="False"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button x:Name="ServiceButton" Click="ServiceButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <StackPanel x:Name="FilterBar" Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="4,0,0,8" Visibility="Collapsed">
            <FontIcon Glyph="&#xE71C;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="FilterText" VerticalAlignment="Center" />
            <Button x:Uid="HistoryPage_22" Content="Show all apps" Click="ShowAllApps_Click" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Apps by data used -->
            <Border Style="{StaticResource TableCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Style="{StaticResource TableHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="HistoryPage_15" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by App" Click="AppHeader_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="36,0,0,0">
                            <TextBlock x:Uid="HistoryPage_8" Text="App" />
                            <FontIcon x:Name="AppSortName" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="HistoryPage_16" Grid.Column="1" Tag="Data" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Data used" Click="AppHeader_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="AppSortData" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Uid="HistoryPage_9" Text="Data used" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ListView
                    x:Name="AppList"
                    Padding="0,0,14,0"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Apps}"
                    SelectionMode="Single"
                    SelectionChanged="AppList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource TableRowStyle}">
                            <Setter Property="MinHeight" Value="60" />
                            <Setter Property="Height" Value="60" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppUsageSlot">
                            <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Width="20" Height="20" Margin="6,0,0,0" Source="{x:Bind Icon, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <Rectangle Width="{x:Bind BarWidth, Mode=OneWay}" Height="4" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                                               Fill="{ThemeResource ChartReceiveBrush}" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Total, Mode=OneWay}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind Split, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            </Border>

            <!-- Connection log -->
            <Border Grid.Column="1" Style="{StaticResource TableCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="LogHeader" Style="{StaticResource TableHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.Time, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W1, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W2, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W3, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W4, Mode=OneWay}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="HistoryPage_17" Tag="Time" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Started" Click="LogHeader_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="HistoryPage_10" Text="Started" />
                            <FontIcon x:Name="LogSortTime" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="HistoryPage_18" Grid.Column="{x:Bind ViewModel.Layout.AppColumn, Mode=OneWay}" Tag="App" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by App" Click="LogHeader_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="HistoryPage_11" Text="App" />
                            <FontIcon x:Name="LogSortApp" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="HistoryPage_19" Grid.Column="{x:Bind ViewModel.Layout.RemoteColumn, Mode=OneWay}" Tag="Remote" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Remote host" Click="LogHeader_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="HistoryPage_12" Text="Remote host" />
                            <FontIcon x:Name="LogSortRemote" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="HistoryPage_20" Grid.Column="{x:Bind ViewModel.Layout.ProtocolColumn, Mode=OneWay}" Tag="Protocol" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Protocol" Click="LogHeader_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="HistoryPage_13" Text="Protocol" />
                            <FontIcon x:Name="LogSortProtocol" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="HistoryPage_21" Grid.Column="{x:Bind ViewModel.Layout.DataColumn, Mode=OneWay}" Tag="Data" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Data" Click="LogHeader_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="HistoryPage_14" Text="Data" />
                            <FontIcon x:Name="LogSortData" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Thumb Tag="Time" Grid.Column="0" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="LogSplitter_DragDelta" />
                    <Thumb Tag="App" Grid.Column="{x:Bind ViewModel.Layout.AppColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="LogSplitter_DragDelta" />
                    <Thumb Tag="Remote" Grid.Column="{x:Bind ViewModel.Layout.RemoteColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="LogSplitter_DragDelta" />
                    <Thumb Tag="Protocol" Grid.Column="{x:Bind ViewModel.Layout.ProtocolColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="LogSplitter_DragDelta" />
                    <Thumb Tag="Data" Grid.Column="{x:Bind ViewModel.Layout.DataColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="LogSplitter_DragDelta" />
                </Grid>
                <ListView
                    x:Name="ConnectionList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Connections}"
                    SelectionMode="Single"
                    ItemContainerStyle="{StaticResource TableRowStyle}"
                    SelectionChanged="ConnectionList_SelectionChanged"
                    ContextRequested="ConnectionList_ContextRequested">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConnectionLogSlot">
                            <Grid Height="40" PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind Layout.Time, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W1, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W2, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W3, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W4, Mode=OneWay}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="10,0,8,0" VerticalAlignment="Center" Text="{x:Bind Time, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind TimeDetail, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid Grid.Column="{x:Bind Layout.AppColumn, Mode=OneWay}" ColumnSpacing="8" Margin="10,0,8,0" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="18" Height="18" Source="{x:Bind Icon, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind App, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Grid.Column="{x:Bind Layout.RemoteColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Remote, Mode=OneWay}"
                                           ToolTipService.ToolTip="{x:Bind RemoteDetail, Mode=OneWay}" />
                                <TextBlock Grid.Column="{x:Bind Layout.ProtocolColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Protocol, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="{x:Bind Layout.DataColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Data, Mode=OneWay}" />
                                <Button x:Uid="Common_RowMenu" Grid.Column="6" Style="{StaticResource RowMenuButtonStyle}" Visibility="{x:Bind MenuVisibility, Mode=OneWay}" Click="RowMenu_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="10,16,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="ConnectionSummaryText" Grid.Row="2" Margin="10,6,0,8" Style="{StaticResource MutedTextStyle}" />
            </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
