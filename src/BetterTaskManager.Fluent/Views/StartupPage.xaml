<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BetterTaskManager.Fluent.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BetterTaskManager.Fluent.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Uid="StartupPage_1" Text="Startup apps" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button x:Name="ToggleButton" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="Toggle_Click" MinWidth="130">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ToggleIcon" Glyph="&#xE7E8;" FontSize="14" />
                    <TextBlock x:Uid="StartupPage_16" x:Name="ToggleLabel" Text="Disable" />
                </StackPanel>
            </Button>
            <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsDynamicOverflowEnabled="True" VerticalAlignment="Center">
                <AppBarButton x:Uid="StartupPage_3" x:Name="OpenLocationButton" Label="Open file location" IsEnabled="False" Click="OpenLocation_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE838;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="StartupPage_4" Label="Refresh" Click="Refresh_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Uid="StartupPage_5" x:Name="PropertiesButton" Label="Properties" IsEnabled="False" Click="Properties_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Uid="StartupPage_6" x:Name="CopyCommandButton" Label="Copy command" IsEnabled="False" Click="CopyCommand_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource TableCardStyle}">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="ColumnHeader" Height="40" Style="{StaticResource TableHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Name, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.W1, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.W2, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.W3, Mode=OneWay}" />
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Button x:Uid="StartupPage_7" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Name" Click="Header_Click">
                <Grid>
                    <TextBlock x:Uid="StartupPage_8" Text="Name" Margin="28,0,0,0" />
                    <FontIcon x:Name="SortName" FontSize="10" Glyph="&#xE70E;" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button x:Uid="StartupPage_9" Grid.Column="{x:Bind ViewModel.Layout.PublisherColumn, Mode=OneWay}" Tag="Publisher" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Publisher" Click="Header_Click">
                <Grid>
                    <TextBlock x:Uid="StartupPage_10" Text="Publisher" />
                    <FontIcon x:Name="SortPublisher" FontSize="10" Glyph="&#xE70E;" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="StartupPage_11" Grid.Column="{x:Bind ViewModel.Layout.StatusColumn, Mode=OneWay}" Tag="Status" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Status" Click="Header_Click">
                <Grid>
                    <TextBlock x:Uid="StartupPage_12" Text="Status" />
                    <FontIcon x:Name="SortStatus" FontSize="10" Glyph="&#xE70E;" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Button>
            <Button x:Uid="StartupPage_13" Grid.Column="{x:Bind ViewModel.Layout.ScopeColumn, Mode=OneWay}" Tag="Scope" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Starts for" Click="Header_Click">
                <Grid>
                    <TextBlock x:Uid="StartupPage_14" Text="Starts for" />
                    <FontIcon x:Name="SortScope" FontSize="10" Glyph="&#xE70E;" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Button>
            <TextBlock x:Uid="StartupPage_15" Grid.Column="4" Text="Command" Margin="8,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Thumb Tag="Name" Grid.Column="0" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Publisher" Grid.Column="{x:Bind ViewModel.Layout.PublisherColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Status" Grid.Column="{x:Bind ViewModel.Layout.StatusColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Scope" Grid.Column="{x:Bind ViewModel.Layout.ScopeColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
        </Grid>

        <ListView
            x:Name="RowList"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="Single"
            ItemContainerStyle="{StaticResource TableRowStyle}"
            SelectionChanged="RowList_SelectionChanged"
            ContextRequested="RowList_ContextRequested"
            DoubleTapped="RowList_DoubleTapped">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:StartupRow">
                    <Grid Height="34" ToolTipService.ToolTip="{x:Bind Command}" PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Layout.Name, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.W1, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.W2, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.W3, Mode=OneWay}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,8,0" Opacity="{x:Bind Opacity}">
                            <Image Width="18" Height="18" Source="{x:Bind Icon}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="{x:Bind Layout.PublisherColumn, Mode=OneWay}" Text="{x:Bind Publisher}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="{x:Bind Layout.StatusColumn, Mode=OneWay}" Text="{x:Bind Status}" ToolTipService.ToolTip="{x:Bind StatusDetail}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="{x:Bind Layout.ScopeColumn, Mode=OneWay}" Text="{x:Bind Scope}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Command}" VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Uid="Common_RowMenu" Grid.Column="5" Style="{StaticResource RowMenuButtonStyle}" Visibility="{x:Bind MenuVisibility, Mode=OneWay}" Click="RowMenu_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </Grid>
        </Border>
    </Grid>
</Page>
