<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="BetterTaskManager.Fluent.Views.NetworkPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:BetterTaskManager.Fluent.ViewModels" xmlns:controls="using:BetterTaskManager.Fluent.Controls" NavigationCacheMode="Required">

    <Grid Padding="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="AppsColumn" Width="380" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Margin="0,0,0,20" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{ThemeResource BadgeReceiveBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE968;" FontSize="19" Foreground="{ThemeResource ToneReceiveBrush}" />
                    </Border>
                    <TextBlock x:Uid="NetworkPage_1" Text="Network" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" Margin="50,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Uid="NetworkPage_25" x:Name="RulesButton" AutomationProperties.Name="Rules" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="Rules_Click" MinWidth="110">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="" FontSize="14" />
                        <TextBlock x:Uid="NetworkPage_24" Text="Rules" />
                    </StackPanel>
                </Button>
                <CommandBar x:Name="PageCommands" DefaultLabelPosition="Right" Background="Transparent" VerticalAlignment="Center">
                    <AppBarButton x:Uid="NetworkPage_32" Label="All rules" Click="AllRules_Click">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE71D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarToggleButton x:Uid="NetworkPage_2" x:Name="EstablishedOnlyButton" Label="Active connections only" Click="EstablishedOnly_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarButton x:Uid="NetworkPage_3" x:Name="FirewallButton" Label="Block network" IsEnabled="False" Click="Firewall_Click">
                        <AppBarButton.Icon>
                            <FontIcon x:Name="FirewallIcon" Glyph="" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarToggleButton x:Uid="NetworkPage_4" x:Name="PauseButton" Label="Pause" Click="Pause_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarToggleButton x:Uid="NetworkPage_26" x:Name="DetailsToggle" Label="Details" Click="DetailsToggle_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </CommandBar>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="12" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:StatTile x:Name="DownloadTile" Stroke="{ThemeResource ChartReceiveBrush}" />
            <controls:StatTile x:Name="UploadTile" Grid.Column="1" Stroke="{ThemeResource ChartSendBrush}" />
            <controls:StatTile x:Name="ConnectionsTile" Grid.Column="2" Stroke="{ThemeResource ChartCpuBrush}" Filled="False" />
        </Grid>

        <controls:DetailPane x:Name="Details" Grid.Row="2" Grid.Column="2" Width="296" Margin="16,0,0,0" />

        <!-- Apps: every program with open sockets, "All apps" on top. -->
        <Border Grid.Row="2" Style="{StaticResource TableCardStyle}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,8,10,8" Background="{ThemeResource SurfaceRaisedBrush}" CornerRadius="10,10,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="NetworkPage_27" Text="Apps" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <ComboBox x:Name="AppSortBox" x:Uid="Network_AppSort" Grid.Column="1" MinWidth="130" SelectionChanged="AppSortBox_SelectionChanged" AutomationProperties.Name="Sort apps">
                        <ComboBoxItem x:Uid="NetworkPage_28" Content="Sort: name" Tag="Name" />
                        <ComboBoxItem x:Uid="NetworkPage_29" Content="Sort: data" Tag="Data" />
                        <ComboBoxItem x:Uid="NetworkPage_30" Content="Sort: speed" Tag="Speed" />
                        <ComboBoxItem x:Uid="Network_SortDownload" Content="Sort: download" Tag="Download" />
                        <ComboBoxItem x:Uid="Network_SortUpload" Content="Sort: upload" Tag="Upload" />
                    </ComboBox>
                    <Button x:Name="AppSortDirection" Grid.Column="2" Margin="6,0,0,0" Click="AppSortDirection_Click">
                        <FontIcon x:Name="AppSortDirectionIcon" Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                    <!-- Narrows only this list, by app name or path; the window's search box filters connections too. -->
                    <TextBox x:Name="AppFilterBox" x:Uid="Network_AppFilter" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" PlaceholderText="Find app" AutomationProperties.Name="Find app" TextChanged="AppFilterBox_TextChanged" />
                </Grid>
                <ListView x:Name="AppList" Grid.Row="1" Padding="0,0,14,0" ItemsSource="{x:Bind ViewModel.Apps}" SelectionMode="Single" SelectionChanged="AppList_SelectionChanged" ContextRequested="List_ContextRequested">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource TableRowStyle}">
                            <Setter Property="MinHeight" Value="56" />
                            <Setter Property="Height" Value="56" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NetworkSlot">
                            <Grid ColumnSpacing="8" Padding="12,0,4,0" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}" PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <Image Width="24" Height="24" Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind IconVisibility, Mode=OneWay}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center">
                                            <Run Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{x:Bind Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                        </TextBlock>
                                        <Border Padding="5,0" VerticalAlignment="Center" CornerRadius="4" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind BlockedVisibility, Mode=OneWay}">
                                            <TextBlock x:Uid="NetworkPage_18" Text="Blocked" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Border>
                                        <Border x:Uid="NetworkPage_22" Padding="5,0" VerticalAlignment="Center" CornerRadius="4" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{x:Bind RulesVisibility, Mode=OneWay}" ToolTipService.ToolTip="This app has its own network rules.">
                                            <TextBlock x:Uid="NetworkPage_23" Text="Rules" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Border>
                                        <Border x:Uid="NetworkPage_19" Padding="5,0" VerticalAlignment="Center" CornerRadius="4" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" Visibility="{x:Bind TunnelVisibility, Mode=OneWay}" ToolTipService.ToolTip="VPN tunnel: carries other apps' traffic in encrypted form, so it is left out of the all-apps total.">
                                            <TextBlock x:Uid="NetworkPage_20" Text="VPN tunnel" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Subline, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                    <Grid Height="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind DownMeter.Bar, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind DownMeter.Rest, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.ColumnSpan="2" RadiusX="2.5" RadiusY="2.5" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Rectangle RadiusX="2.5" RadiusY="2.5" Fill="{ThemeResource ChartReceiveBrush}" />
                                    </Grid>
                                    <Grid Height="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind UpMeter.Bar, Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind UpMeter.Rest, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.ColumnSpan="2" RadiusX="2.5" RadiusY="2.5" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Rectangle RadiusX="2.5" RadiusY="2.5" Fill="{ThemeResource ChartSendBrush}" />
                                    </Grid>
                                </StackPanel>
                                <Button x:Uid="Common_RowMenu" Grid.Column="3" Style="{StaticResource RowMenuButtonStyle}" Visibility="{x:Bind MenuVisibility, Mode=OneWay}" Click="RowMenu_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Connections of the selected app, with its traffic underneath. -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TableCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,8,10,8" ColumnSpacing="6" Background="{ThemeResource SurfaceRaisedBrush}" CornerRadius="10,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Network_ConnectionsHeading" Text="Connections" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ConnectionSortBox" x:Uid="Network_ConnectionSort" Grid.Column="1" MinWidth="160" SelectionChanged="ConnectionSortBox_SelectionChanged" AutomationProperties.Name="Sort connections">
                        <ComboBoxItem x:Uid="Network_SortRemote" Content="Sort: remote host" Tag="Remote" />
                        <ComboBoxItem x:Uid="Network_SortApp" Content="Sort: app" Tag="App" />
                        <ComboBoxItem x:Uid="Network_SortLocal" Content="Sort: local address" Tag="Local" />
                        <ComboBoxItem x:Uid="Network_SortScope" Content="Sort: scope" Tag="Scope" />
                        <ComboBoxItem x:Uid="Network_SortState" Content="Sort: state" Tag="State" />
                        <ComboBoxItem x:Uid="Network_SortDownload" Content="Sort: download" Tag="Download" />
                        <ComboBoxItem x:Uid="Network_SortUpload" Content="Sort: upload" Tag="Upload" />
                    </ComboBox>
                    <Button x:Name="ConnectionSortDirection" Grid.Column="2" Click="ConnectionSortDirection_Click">
                        <FontIcon x:Name="ConnectionSortDirectionIcon" Glyph="&#xE70E;" FontSize="12" />
                    </Button>
                </Grid>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled"><Grid MinWidth="{x:Bind ViewModel.Layout.TableWidth, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="12,8,10,8" Background="{ThemeResource SurfaceRaisedBrush}" CornerRadius="10,10,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="SelectedAppIcon" Width="24" Height="24" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedAppName" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SelectedAppDetail" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SelectedPolicy" Style="{StaticResource MutedTextStyle}" MaxWidth="520" HorizontalAlignment="Left" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ColumnHeader" Grid.Row="1" Height="40" Style="{StaticResource TableHeaderStyle}" CornerRadius="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W0, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W1, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W2, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W3, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W4, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W5, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W6, Mode=OneWay}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="NetworkPage_8" Grid.Column="{x:Bind ViewModel.Layout.RemoteColumn, Mode=OneWay}" Tag="Remote" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Remote host" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,0">
                            <TextBlock x:Uid="NetworkPage_9" Text="Remote host" />
                            <FontIcon x:Name="SortRemote" FontSize="10" Glyph="" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Network_HeaderApp" Grid.Column="{x:Bind ViewModel.Layout.AppColumn, Mode=OneWay}" Tag="App" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by App" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="NetworkPage_31" Text="App" />
                            <FontIcon x:Name="SortApp" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Network_HeaderLocal" Grid.Column="{x:Bind ViewModel.Layout.LocalColumn, Mode=OneWay}" Tag="Local" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Local address" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="NetworkPage_7" Text="Local address" />
                            <FontIcon x:Name="SortLocal" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Network_HeaderScope" Grid.Column="{x:Bind ViewModel.Layout.ScopeColumn, Mode=OneWay}" Tag="Scope" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Scope" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="NetworkPage_10" Text="Scope" />
                            <FontIcon x:Name="SortScope" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="NetworkPage_11" Grid.Column="{x:Bind ViewModel.Layout.StateColumn, Mode=OneWay}" Tag="State" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by State" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="NetworkPage_12" Text="State" />
                            <FontIcon x:Name="SortState" FontSize="10" Glyph="" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Network_HeaderDownload" Grid.Column="{x:Bind ViewModel.Layout.DownloadColumn, Mode=OneWay}" Tag="Download" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Download" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="Network_DownloadHeader" Text="Download" />
                            <FontIcon x:Name="SortDownload" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="Network_HeaderUpload" Grid.Column="{x:Bind ViewModel.Layout.UploadColumn, Mode=OneWay}" Tag="Upload" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Upload" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="Network_UploadHeader" Text="Upload" />
                            <FontIcon x:Name="SortUpload" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Thumb Tag="Remote" Grid.Column="{x:Bind ViewModel.Layout.RemoteColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Thumb Tag="App" Grid.Column="{x:Bind ViewModel.Layout.AppColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Thumb Tag="Local" Grid.Column="{x:Bind ViewModel.Layout.LocalColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Thumb Tag="Scope" Grid.Column="{x:Bind ViewModel.Layout.ScopeColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Thumb Tag="State" Grid.Column="{x:Bind ViewModel.Layout.StateColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Thumb Tag="Download" Grid.Column="{x:Bind ViewModel.Layout.DownloadColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Thumb Tag="Upload" Grid.Column="{x:Bind ViewModel.Layout.UploadColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                </Grid>

                <ListView x:Name="ConnectionList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Connections}" SelectionMode="Single" ItemContainerStyle="{StaticResource TableRowStyle}" SelectionChanged="ConnectionList_SelectionChanged" ContextRequested="List_ContextRequested">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NetworkSlot">
                            <Grid Height="40" ToolTipService.ToolTip="{x:Bind RemoteDetail, Mode=OneWay}" PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind Layout.W0, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W1, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W2, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W3, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W4, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W5, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W6, Mode=OneWay}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="{x:Bind Layout.RemoteColumn, Mode=OneWay}" Margin="12,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind Remote, Mode=OneWay}" />
                                    <Run Text="{x:Bind Name, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </TextBlock>
                                <TextBlock Grid.Column="{x:Bind Layout.AppColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind AppName, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="{x:Bind Layout.LocalColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Local, Mode=OneWay}" />
                                <TextBlock Grid.Column="{x:Bind Layout.ScopeColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" Text="{x:Bind Scope, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="{x:Bind Layout.StateColumn, Mode=OneWay}" Orientation="Horizontal" Spacing="7" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{x:Bind StateBrush, Mode=OneWay}" Visibility="{x:Bind StateDotVisibility, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind State, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="{x:Bind Layout.DownloadColumn, Mode=OneWay}" Margin="10,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind DownloadText, Mode=OneWay}" />
                                <TextBlock Grid.Column="{x:Bind Layout.UploadColumn, Mode=OneWay}" Margin="10,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind UploadText, Mode=OneWay}" />
                                <Button x:Uid="Common_RowMenu" Grid.Column="8" Style="{StaticResource RowMenuButtonStyle}" Visibility="{x:Bind MenuVisibility, Mode=OneWay}" Click="RowMenu_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="3" Padding="12,8,12,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="TrafficTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource ChartReceiveBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TrafficDown" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource ChartSendBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TrafficUp" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <controls:TrendChart x:Name="TrafficChart" Grid.Row="1" Height="90" Stroke="{ThemeResource ChartReceiveBrush}" SecondStroke="{ThemeResource ChartSendBrush}" />
                </Grid>
            </Grid></ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
