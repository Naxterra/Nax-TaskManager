<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BetterTaskManager.Fluent.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BetterTaskManager.Fluent.ViewModels"
    xmlns:controls="using:BetterTaskManager.Fluent.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Margin="4,0,0,12" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Uid="NetworkPage_1" Text="Network" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Uid="NetworkPage_25" x:Name="RulesButton" AutomationProperties.Name="Rules" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="Rules_Click" MinWidth="110">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                        <TextBlock x:Uid="NetworkPage_24" Text="Rules" />
                    </StackPanel>
                </Button>
                <CommandBar DefaultLabelPosition="Right" Background="Transparent" VerticalAlignment="Center">
                    <AppBarToggleButton x:Uid="NetworkPage_2" x:Name="EstablishedOnlyButton" Label="Active connections only" Click="EstablishedOnly_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE71C;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarButton x:Uid="NetworkPage_3" x:Name="FirewallButton" Label="Block network" IsEnabled="False" Click="Firewall_Click">
                        <AppBarButton.Icon>
                            <FontIcon x:Name="FirewallIcon" Glyph="&#xE785;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarToggleButton x:Uid="NetworkPage_4" x:Name="PauseButton" Label="Pause" Click="Pause_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE769;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarToggleButton x:Uid="NetworkPage_26" x:Name="DetailsToggle" Label="Details" Click="DetailsToggle_Click">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE8A0;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </CommandBar>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:StatTile x:Name="DownloadTile" Stroke="{ThemeResource ChartReceiveBrush}" />
            <controls:StatTile x:Name="UploadTile" Grid.Column="1" Stroke="{ThemeResource ChartSendBrush}" />
            <controls:StatTile x:Name="ConnectionsTile" Grid.Column="2" Stroke="{ThemeResource ChartCpuBrush}" Filled="False" />
        </Grid>

        <controls:DetailPane x:Name="Details" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="340" Margin="12,0,0,0" />

        <Border Grid.Row="2" Style="{StaticResource TableCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="ColumnHeader" Height="40" Style="{StaticResource TableHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.Name, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W1, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W2, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W3, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W4, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W5, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind ViewModel.Layout.W6, Mode=OneWay}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Button x:Uid="NetworkPage_5" Grid.Column="0" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Name" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="36,0,0,0">
                            <TextBlock x:Uid="NetworkPage_6" Text="App / protocol" />
                            <FontIcon x:Name="SortName" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="{x:Bind ViewModel.Layout.LocalColumn, Mode=OneWay}" Tag="Local" Background="Transparent">
                        <TextBlock x:Uid="NetworkPage_7" Text="Local address" Margin="10,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Button x:Uid="NetworkPage_8" Grid.Column="{x:Bind ViewModel.Layout.RemoteColumn, Mode=OneWay}" Tag="Remote" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Remote host" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="NetworkPage_9" Text="Remote host" />
                            <FontIcon x:Name="SortRemote" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="{x:Bind ViewModel.Layout.ScopeColumn, Mode=OneWay}" Tag="Scope" Background="Transparent">
                        <TextBlock x:Uid="NetworkPage_10" Text="Scope" Margin="10,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Thumb Tag="Scope" Grid.Column="{x:Bind ViewModel.Layout.ScopeColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Button x:Uid="NetworkPage_11" Grid.Column="{x:Bind ViewModel.Layout.StateColumn, Mode=OneWay}" Tag="State" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by State" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="NetworkPage_12" Text="State" />
                            <FontIcon x:Name="SortState" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="NetworkPage_13" Grid.Column="{x:Bind ViewModel.Layout.DataColumn, Mode=OneWay}" Tag="Data" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Data" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="NetworkPage_14" Text="Data (down / up)" />
                            <FontIcon x:Name="SortData" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="NetworkPage_15" Grid.Column="{x:Bind ViewModel.Layout.SpeedColumn, Mode=OneWay}" Tag="Speed" Style="{StaticResource ColumnHeaderButtonStyle}" AutomationProperties.Name="Sort by Speed" Click="Header_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                            <TextBlock x:Uid="NetworkPage_16" Text="Speed (down / up)" />
                            <FontIcon x:Name="SortSpeed" FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Thumb Tag="Name" Grid.Column="0" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Thumb Tag="Local" Grid.Column="{x:Bind ViewModel.Layout.LocalColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Thumb Tag="Remote" Grid.Column="{x:Bind ViewModel.Layout.RemoteColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Thumb Tag="State" Grid.Column="{x:Bind ViewModel.Layout.StateColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Thumb Tag="Data" Grid.Column="{x:Bind ViewModel.Layout.DataColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                    <Thumb Tag="Speed" Grid.Column="{x:Bind ViewModel.Layout.SpeedColumn, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
                </Grid>

                <ListView
                    x:Name="RowList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Rows}"
                    SelectionMode="Single"
                    ItemContainerStyle="{StaticResource TableRowStyle}"
                    SelectionChanged="RowList_SelectionChanged"
                    ContextRequested="RowList_ContextRequested"
                    DoubleTapped="RowList_DoubleTapped">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NetworkSlot">
                            <Grid Height="34" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}" PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind Layout.Name, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W1, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W2, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W3, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W4, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W5, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind Layout.W6, Mode=OneWay}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="{x:Bind Indent, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Uid="NetworkPage_17" Width="28" Height="28" AutomationProperties.Name="Expand or collapse" Padding="0" Background="Transparent" BorderThickness="0"
                                            Visibility="{x:Bind ChevronVisibility, Mode=OneWay}" Click="Chevron_Click">
                                        <FontIcon Glyph="&#xE76C;" FontSize="10" RenderTransformOrigin="0.5,0.5">
                                            <FontIcon.RenderTransform>
                                                <RotateTransform Angle="{x:Bind ChevronAngle, Mode=OneWay}" />
                                            </FontIcon.RenderTransform>
                                        </FontIcon>
                                    </Button>
                                    <Image Grid.Column="1" Width="20" Height="20" Margin="0,0,8,0" Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                        <Run Text="{x:Bind Name, Mode=OneWay}" FontWeight="{x:Bind NameWeight, Mode=OneWay}" />
                                        <Run Text="{x:Bind Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    </TextBlock>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Border Margin="0,0,8,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="4"
                                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                Visibility="{x:Bind BlockedVisibility, Mode=OneWay}">
                                            <TextBlock x:Uid="NetworkPage_18" Text="Blocked" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Border>
                                        <Border x:Uid="NetworkPage_22" Margin="0,0,8,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="4"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                Visibility="{x:Bind RulesVisibility, Mode=OneWay}"
                                                ToolTipService.ToolTip="This app has its own network rules.">
                                            <TextBlock x:Uid="NetworkPage_23" Text="Rules" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </Border>
                                        <Border x:Uid="NetworkPage_19" Margin="0,0,8,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="4"
                                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                Visibility="{x:Bind TunnelVisibility, Mode=OneWay}"
                                                ToolTipService.ToolTip="VPN tunnel: carries other apps' traffic in encrypted form, so it is left out of the all-apps total.">
                                            <TextBlock x:Uid="NetworkPage_20" Text="VPN tunnel" FontSize="11" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Column="{x:Bind Layout.SpanColumn, Mode=OneWay}" Grid.ColumnSpan="{x:Bind Layout.SpanCount, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Summary, Mode=OneWay}" />
                                <TextBlock Grid.Column="{x:Bind Layout.LocalColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Local, Mode=OneWay}" />
                                <TextBlock Grid.Column="{x:Bind Layout.RemoteColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Remote, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind RemoteDetail, Mode=OneWay}" />
                                <TextBlock Grid.Column="{x:Bind Layout.ScopeColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" Text="{x:Bind Scope, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="{x:Bind Layout.StateColumn, Mode=OneWay}" Orientation="Horizontal" Spacing="7" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{x:Bind StateBrush, Mode=OneWay}" Visibility="{x:Bind StateDotVisibility, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind State, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="{x:Bind Layout.DataColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" Text="{x:Bind Transferred, Mode=OneWay}" />
                                <TextBlock Grid.Column="{x:Bind Layout.SpeedColumn, Mode=OneWay}" Margin="10,0,8,0" VerticalAlignment="Center" Text="{x:Bind Speed, Mode=OneWay}" />
                                <Button x:Uid="Common_RowMenu" Grid.Column="8" Style="{StaticResource RowMenuButtonStyle}" Visibility="{x:Bind MenuVisibility, Mode=OneWay}" Click="RowMenu_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
