<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BetterTaskManager.Fluent.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BetterTaskManager.Fluent.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Network" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <CommandBar Grid.Column="2" DefaultLabelPosition="Right" Background="Transparent" VerticalAlignment="Center">
                <AppBarToggleButton x:Name="EstablishedOnlyButton" Label="Active connections only" Click="EstablishedOnly_Click">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE71C;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton x:Name="FirewallButton" Label="Block network" IsEnabled="False" Click="Firewall_Click">
                    <AppBarButton.Icon>
                        <FontIcon x:Name="FirewallIcon" Glyph="&#xE785;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" Height="36" Padding="0,0,12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Name, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Local, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Remote, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.State, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind ViewModel.Layout.Speed, Mode=OneWay}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="App / protocol" Margin="44,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="Local address" Margin="10,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" Text="Remote host" Margin="10,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="3" Text="State" Margin="10,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="4" Text="Speed (down / up)" Margin="10,0,0,6" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Thumb Tag="Name" Grid.Column="0" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Local" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Remote" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="State" Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
            <Thumb Tag="Speed" Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource ColumnSplitterStyle}" DragDelta="Splitter_DragDelta" />
        </Grid>

        <ListView
            x:Name="RowList"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="Single"
            ItemContainerStyle="{StaticResource TableRowStyle}"
            SelectionChanged="RowList_SelectionChanged"
            RightTapped="RowList_RightTapped"
            DoubleTapped="RowList_DoubleTapped">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:NetworkSlot">
                    <Grid Height="34" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Layout.Name, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Local, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Remote, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.State, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Layout.Speed, Mode=OneWay}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="{x:Bind Indent, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                                    Visibility="{x:Bind ChevronVisibility, Mode=OneWay}" Click="Chevron_Click">
                                <FontIcon Glyph="&#xE76C;" FontSize="10" RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="{x:Bind ChevronAngle, Mode=OneWay}" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Button>
                            <Image Grid.Column="1" Width="18" Height="18" Margin="0,0,6,0" Source="{x:Bind Icon, Mode=OneWay}" Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                <Run Text="{x:Bind Name, Mode=OneWay}" FontWeight="{x:Bind NameWeight, Mode=OneWay}" />
                                <Run Text="{x:Bind Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                            </TextBlock>
                            <Border Grid.Column="3" Margin="0,0,8,0" Padding="6,1" VerticalAlignment="Center" CornerRadius="4"
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    Visibility="{x:Bind BlockedVisibility, Mode=OneWay}">
                                <TextBlock Text="Blocked" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Summary, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Local, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind Remote, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind RemoteDetail, Mode=OneWay}" />
                        <TextBlock Grid.Column="3" Margin="10,0,8,0" VerticalAlignment="Center" Text="{x:Bind State, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Margin="10,0,8,0" VerticalAlignment="Center" Text="{x:Bind Speed, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
