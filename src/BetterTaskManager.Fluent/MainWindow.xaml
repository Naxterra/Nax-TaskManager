<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BetterTaskManager.Fluent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nax-TaskManager">

    <Grid x:Name="WindowRoot" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Nax-TaskManager" IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Uid="MainWindow_1"
                    x:Name="SearchBox"
                    MinWidth="320"
                    MaxWidth="520"
                    VerticalAlignment="Center"
                    PlaceholderText="Search by name, publisher or PID"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="700"
            ExpandedModeThresholdWidth="1280"
            IsPaneOpen="True"
            OpenPaneLength="216"
            IsSettingsVisible="True"
            SelectionChanged="Navigation_SelectionChanged">
                        <NavigationView.PaneHeader>
                <StackPanel x:Name="BrandPanel" Margin="20,12,12,24" Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="NAX" FontSize="27" FontWeight="Bold" CharacterSpacing="120" />
                        <Border Background="{ThemeResource BrandSoftBrush}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                            <TextBlock Text="TM" Foreground="{ThemeResource BrandBrush}" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Uid="Design_Product" Text="System intelligence" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Design_OverviewNav" Content="Overview" Tag="Overview" ToolTipService.ToolTip="Overview (Ctrl+0)">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" Foreground="{ThemeResource ToneBrandBrush}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_2" Content="Processes" Tag="Processes" ToolTipService.ToolTip="Processes (Ctrl+1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;" Foreground="{ThemeResource ToneCpuBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_3" Content="Performance" Tag="Performance" ToolTipService.ToolTip="Performance (Ctrl+2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" Foreground="{ThemeResource ToneMemoryBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_4" Content="Network" Tag="Network" ToolTipService.ToolTip="Network (Ctrl+3)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" Foreground="{ThemeResource ToneReceiveBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_10" Content="Disk" Tag="Disk" ToolTipService.ToolTip="Disk (Ctrl+4)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" Foreground="{ThemeResource ToneDiskBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_5" Content="History" Tag="History" ToolTipService.ToolTip="History (Ctrl+5)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" Foreground="{ThemeResource ToneGpuBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_9" Content="Startup apps" Tag="Startup" ToolTipService.ToolTip="Startup apps (Ctrl+6)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B5;" Foreground="{ThemeResource ToneWarnBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="RulesPage_Nav" Content="Rules" Tag="Rules" ToolTipService.ToolTip="Rules (Ctrl+7)">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" Foreground="{ThemeResource ToneRoseBrush}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Limited mode as a card at the bottom of the pane, where it does not push the content down. -->
                        <NavigationView.PaneFooter>
                <StackPanel x:Name="PaneFooterContent">
                    <Border Margin="10,0,10,12" Padding="12" Background="{ThemeResource SurfaceBrush}" CornerRadius="10" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="6" Height="6" Fill="{ThemeResource BrandBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="MachineText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="MachineStats" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                <Border x:Name="LimitedCard" Margin="8,0,8,8" Padding="12" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource StateWarnBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Uid="MainWindow_14" Grid.Column="1" Text="Limited access" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock x:Name="LimitedText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        <Button x:Uid="MainWindow_15" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" Click="RestartElevated_Click">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA18;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Uid="MainWindow_16" Grid.Column="1" Text="Run as administrator" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel></NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                <InfoBar x:Uid="MainWindow_13"
                    x:Name="CollectionBar"
                    Margin="16,8,16,0"
                    IsClosable="False"
                    Severity="Error"
                    Title="Measuring failed"
                    Message="" />
                <InfoBar x:Uid="MainWindow_11"
                    x:Name="ReplaceLostBar"
                    Margin="16,8,16,0"
                    IsClosable="True"
                    Severity="Warning"
                    Title="Windows Task Manager is no longer replaced"
                    Message="Another program or Windows removed the setting.">
                    <InfoBar.ActionButton>
                        <Button x:Uid="MainWindow_12" x:Name="RestoreReplaceButton" Content="Restore" Click="RestoreReplace_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Uid="MainWindow_6"
                    x:Name="ElevationBar"
                    Margin="16,8,16,0"
                    IsClosable="True"
                    Severity="Informational"
                    Title="Limited mode"
                    Message="Per-app network speed and system process details need administrator rights.">
                    <InfoBar.ActionButton>
                        <Button x:Uid="MainWindow_7" Content="Restart as administrator" Click="RestartElevated_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <!-- Status strip: whether the numbers are live and where they come from. -->
        <Grid Grid.Row="2" Height="32" Padding="20,0" Background="{ThemeResource AppPaneBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{ThemeResource StateIdleBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LiveText" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SourceText" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="VersionText" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
