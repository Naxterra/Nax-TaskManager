<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BetterTaskManager.Fluent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nax-TaskManager">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Nax-TaskManager" IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Uid="MainWindow_1"
                    x:Name="SearchBox"
                    MinWidth="320"
                    MaxWidth="520"
                    VerticalAlignment="Center"
                    PlaceholderText="Search by name, publisher or PID"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="220"
            IsSettingsVisible="True"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="MainWindow_2" Content="Processes" Tag="Processes" ToolTipService.ToolTip="Processes (Ctrl+1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_3" Content="Performance" Tag="Performance" ToolTipService.ToolTip="Performance (Ctrl+2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_4" Content="Network" Tag="Network" ToolTipService.ToolTip="Network (Ctrl+3)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_5" Content="History" Tag="History" ToolTipService.ToolTip="History (Ctrl+4)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="MainWindow_9" Content="Startup apps" Tag="Startup" ToolTipService.ToolTip="Startup apps (Ctrl+5)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Uid="MainWindow_6"
                    x:Name="ElevationBar"
                    Margin="16,8,16,0"
                    IsClosable="True"
                    Severity="Informational"
                    Title="Limited mode"
                    Message="Per-app network speed and system process details need administrator rights.">
                    <InfoBar.ActionButton>
                        <Button x:Uid="MainWindow_7" Content="Restart as administrator" Click="RestartElevated_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
