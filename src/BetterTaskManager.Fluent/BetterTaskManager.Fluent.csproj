<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>BetterTaskManager.Fluent</RootNamespace>
    <AssemblyName>Nax-TaskManager</AssemblyName>
    <Product>Nax-TaskManager</Product>
    <Company>Naxterra</Company>
    <Version>2.0.0-alpha.22</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <ProjectReference Include="..\BetterTaskManager.Core\BetterTaskManager.Core.csproj" />
    <!-- Build-order only, so restore covers the service; its files are copied by BundleHistoryService. -->
    <ProjectReference Include="..\BetterTaskManager.HistoryService\BetterTaskManager.HistoryService.csproj" ReferenceOutputAssembly="false" Private="false" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The background history service ships in a HistoryService folder next to the app; Settings installs it from there. -->
  <Target Name="BundleHistoryService" AfterTargets="Build">
    <MSBuild Projects="..\BetterTaskManager.HistoryService\BetterTaskManager.HistoryService.csproj" Targets="Build" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="HistoryServiceAssembly" />
    </MSBuild>
    <PropertyGroup>
      <HistoryServiceOutput>@(HistoryServiceAssembly->'%(RootDir)%(Directory)')</HistoryServiceOutput>
    </PropertyGroup>
    <ItemGroup>
      <HistoryServiceFiles Include="$(HistoryServiceOutput)**\*" Exclude="$(HistoryServiceOutput)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(HistoryServiceFiles)" DestinationFiles="@(HistoryServiceFiles->'$(OutDir)HistoryService\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BundleHistoryServiceToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedHistoryServiceFiles Include="$(OutDir)HistoryService\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedHistoryServiceFiles)" DestinationFiles="@(PublishedHistoryServiceFiles->'$(PublishDir)HistoryService\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyGeneratedXamlToPublish" AfterTargets="Publish">
    <ItemGroup>
      <GeneratedXamlResources Include="$(TargetDir)*.xbf" />
      <GeneratedPriResources Include="$(TargetDir)$(AssemblyName).pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
    </ItemGroup>
    <Copy SourceFiles="@(GeneratedXamlResources)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GeneratedPriResources)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
