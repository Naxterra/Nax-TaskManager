<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BetterTaskManager</AssemblyName>
    <RootNamespace>BetterTaskManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0-preview.41</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0-preview.41</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Better Task Manager</Product>
    <Title>Better Task Manager</Title>
    <AssemblyTitle>Better Task Manager</AssemblyTitle>
    <Authors>Better Task Manager Contributors</Authors>
    <Description>A Windows process, memory, firewall, and network visibility tool inspired by Task Manager and Portmaster.</Description>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
